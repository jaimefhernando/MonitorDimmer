<Window x:Class="MonitorDimmer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MonitorDimmer.UI"
        xmlns:c="clr-namespace:MonitorDimmer.UI.Controls"
        Title="Monitor Dimmer" Width="1180" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" FontFamily="{DynamicResource AppFont}" FontSize="14"
        Foreground="{DynamicResource TextMain}">
    <Window.Resources>
        <!-- Page header: small letter-spaced line over the page title -->
        <Style x:Key="PageHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="PageScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="32,28,24,24" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}" />
    </Window.Resources>

    <!-- Custom title bar: WindowChrome removes the native caption but keeps resizing, snapping,
         Aero Shake, double-click to maximize and the system menu (Alt+Space / right-click). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
    <DockPanel>
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- Continues the sidebar's background and divider up to the top edge -->
            <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" />
            <Border Grid.Column="1" Background="{DynamicResource WindowBg}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Style="{StaticResource TitleBarIcon}" Data="M0,5.5 H10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Click="Maximize_Click"
                        ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <Grid>
                        <Path x:Name="MaximizeIcon" Style="{StaticResource TitleBarIcon}" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
                        <Path x:Name="RestoreIcon" Style="{StaticResource TitleBarIcon}" Visibility="Collapsed"
                              Data="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click"
                        ToolTip="Close to tray" AutomationProperties.Name="Close">
                    <Path Style="{StaticResource TitleBarIcon}" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" />
                </Button>
            </StackPanel>
        </Grid>

    <TabControl x:Name="Nav" Style="{StaticResource Sidebar}">

        <!-- Home -->
        <TabItem x:Name="HomeTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Home">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="M3,11 L12,4 L21,11 M5,10 V20 H19 V10" />
                    <TextBlock Text="Home" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ui:HomeView x:Name="Home" />
        </TabItem>

        <!-- Games -->
        <TabItem x:Name="GamesTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Games">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M6,7 H18 A4,4 0 0 1 22,11 V14 A4,4 0 0 1 18,18 H6 A4,4 0 0 1 2,14 V11 A4,4 0 0 1 6,7 Z M7,11 V14 M5.5,12.5 H8.5 M15.5,11.5 H16.5 M17.5,13.5 H18.5" />
                    <TextBlock Text="Games" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="+  Add game" Style="{StaticResource AccentButton}" Margin="0"
                                MinHeight="44" VerticalAlignment="Center" Click="AddGame_Click" />
                        <StackPanel>
                            <TextBlock x:Name="GamesKicker" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Games" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <ui:ProfilesView x:Name="Profiles" Margin="0,0,0,24" />

                    <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="DETECTION" Margin="0,0,0,10" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Scan again" Click="Rescan_Click" Margin="0" VerticalAlignment="Center" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoDetectGames}" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Detect games automatically" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                                   Text="Steam, Epic, GOG, Ubisoft, EA, Xbox and Riot games, and anything Windows Game Bar recognises" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                            <TextBlock x:Name="GamesSummary" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8" />
                            <ListBox x:Name="GamesList" Height="160"
                                     Visibility="{Binding AutoDetectGames, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="Detected games">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Source}" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Watched apps" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Video players and anything else that should start the dimming." />
                                <ui:AppListEditor x:Name="WatchedEditor" PickerTitle="Add watched apps" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Exceptions" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Never start the dimming, and stay visible on dimmed monitors (Discord, OBS)." />
                                <ui:AppListEditor x:Name="ExceptionEditor" PickerTitle="Add exceptions" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Monitors -->
        <TabItem x:Name="MonitorsTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Monitors">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="M2,4 H22 V17 H2 Z M8,21 H16 M12,17 V21" />
                    <TextBlock Text="Monitors" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="Identify monitors" Click="Identify_Click" Margin="0"
                                MinHeight="44" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock x:Name="MonitorsKicker" Style="{StaticResource Kicker}" />
                            <TextBlock Text="Monitors" Style="{StaticResource PageTitle}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="ARRANGEMENT" Margin="0,0,0,14" />
                            <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    Padding="24" Height="230">
                                <c:MonitorMap x:Name="MonitorsMap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="MonitorList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:ChamferBorder Chamfer="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}"
                                                 BorderThickness="1" Padding="22,18" Margin="0,0,14,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BrightnessStatus}" Style="{StaticResource Hint}" Margin="0,0,0,6" FontSize="12" />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NeverDim}" Content="Never dim this monitor" />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseCustomStrength}" Content="Its own darkness" />
                                        <DockPanel Visibility="{Binding UseCustomStrength, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Strength, StringFormat={}{0} %}" FontWeight="Bold"
                                                       Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}"
                                                    AutomationProperties.Name="Darkness for this monitor" />
                                        </DockPanel>
                                    </StackPanel>
                                </c:ChamferBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="BURN-IN PROTECTION" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IdleDimEnabled}">
                                    <TextBlock Text="Idle dimming" FontSize="18" FontWeight="Bold" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Darkens a monitor you haven't used. Moving the mouse onto it wakes it instantly. Monitors showing a fullscreen window, a game, a watched app or an exception app count as in use." />
                                <StackPanel IsEnabled="{Binding IdleDimEnabled}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IdleMinutes, StringFormat={}{0} min}" FontWeight="Bold" />
                                        <TextBlock Text="After" />
                                    </DockPanel>
                                    <Slider Minimum="1" Maximum="30" TickFrequency="1" Value="{Binding IdleMinutes}" AutomationProperties.Name="Idle after minutes" />
                                    <DockPanel Margin="0,10,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IdleStrength, StringFormat={}{0} %}" FontWeight="Bold" />
                                        <TextBlock Text="Darkness" />
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding IdleStrength}" AutomationProperties.Name="Idle darkness" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="SCHEDULE" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NightEnabled}">
                                    <TextBlock Text="Night mode" FontSize="18" FontWeight="Bold" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="A warm, slightly darker tint in the evening. The monitor with your game stays clear. Also in the tray menu." />
                                <StackPanel IsEnabled="{Binding NightEnabled}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="From" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NightStart, UpdateSourceTrigger=PropertyChanged, Delay=600}" Width="84"
                                                     ToolTip="24-hour time, e.g. 21:00" AutomationProperties.Name="Night mode from" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="To" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding NightEnd, UpdateSourceTrigger=PropertyChanged, Delay=600}" Width="84"
                                                     ToolTip="24-hour time, e.g. 07:00" AutomationProperties.Name="Night mode to" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Monitors" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                                                <UniformGrid Rows="1" AutomationProperties.Name="Which monitors">
                                                    <RadioButton Style="{StaticResource Segment}" Content="Side only" GroupName="NightMonitors"
                                                                 IsChecked="{Binding NightAllMonitors, Converter={StaticResource EnumMatch}, ConverterParameter=False}" />
                                                    <RadioButton Style="{StaticResource Segment}" Content="All" GroupName="NightMonitors"
                                                                 IsChecked="{Binding NightAllMonitors}" />
                                                </UniformGrid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding NightStrength, StringFormat={}{0} %}" FontWeight="Bold" />
                                        <TextBlock Text="Strength" />
                                    </DockPanel>
                                    <Slider Minimum="5" Maximum="80" TickFrequency="5" Value="{Binding NightStrength}" AutomationProperties.Name="Night mode strength" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Lighting -->
        <TabItem x:Name="LightingTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Lighting">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M9,18 H15 M10,21 H14 M12,3 A6,6 0 0 0 8,13.5 C8.7,14.2 9,15 9,16 H15 C15,15 15.3,14.2 16,13.5 A6,6 0 0 0 12,3 Z" />
                    <TextBlock Text="Lighting" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="RGB WHILE PLAYING" />
                        <TextBlock Text="Lighting" Style="{StaticResource PageTitle}" />
                    </StackPanel>

                    <c:ChamferBorder Chamfer="16" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}"
                                     BorderThickness="1" Padding="22,20" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RgbEnabled}">
                                <StackPanel>
                                    <TextBlock Text="Change RGB lighting while dimming" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Keyboards, mice and headsets go dark or dim with your monitors, then back to your own lighting."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel IsEnabled="{Binding RgbEnabled}" Margin="0,12,0,0">
                                <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" HorizontalAlignment="Left" Width="360">
                                    <UniformGrid Rows="1" AutomationProperties.Name="Lighting while dimming">
                                        <RadioButton x:Name="RgbOffRadio" Style="{StaticResource Segment}" GroupName="RgbStyle"
                                                     Content="Lights off" Checked="RgbStyle_Checked" />
                                        <RadioButton x:Name="RgbColorRadio" Style="{StaticResource Segment}" GroupName="RgbStyle"
                                                     Content="Dim color" Checked="RgbStyle_Checked" />
                                    </UniformGrid>
                                </Border>
                                <StackPanel x:Name="ColorPanel" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ColorPreview" Width="38" Height="38"
                                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="0,0,10,0" />
                                        <TextBox Text="{Binding RgbColor, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 Width="104" FontFamily="Consolas" Margin="0,0,16,0" ToolTip="Color as #RRGGBB"
                                                 AutomationProperties.Name="Lighting color" />
                                        <ItemsControl x:Name="Swatches" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                            Tag="{Binding Hex}" ToolTip="{Binding Hex}" Click="Swatch_Click"
                                                            AutomationProperties.Name="{Binding Hex}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <DockPanel Margin="0,14,0,0" MaxWidth="520" HorizontalAlignment="Left" Width="520">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RgbBrightness, StringFormat={}{0} %}" FontWeight="Bold"
                                                   Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Text="Brightness" Width="90" VerticalAlignment="Center" />
                                        <Slider Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding RgbBrightness}"
                                                AutomationProperties.Name="Lighting brightness" />
                                    </DockPanel>
                                </StackPanel>
                                <Button Content="Preview for 3 seconds" Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Left" Margin="0,18,0,0" MinHeight="44" Click="PreviewLighting_Click" />
                            </StackPanel>
                        </StackPanel>
                    </c:ChamferBorder>

                    <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="DEVICES" Margin="0,8,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseRazerChroma}">
                                    <TextBlock Text="Razer Chroma" FontSize="17" FontWeight="Bold" />
                                </CheckBox>
                                <TextBlock x:Name="RazerStatus" Style="{StaticResource Hint}" Margin="0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseOpenRgb}">
                                    <StackPanel>
                                        <TextBlock Text="OpenRGB" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="ASUS Aura, Corsair, Logitech, MSI and more" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                           Text="In OpenRGB, save one profile for dimming and one with your normal lighting, then turn on SDK Server → Start Server." />
                                <Grid IsEnabled="{Binding UseOpenRgb}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="44" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="While dimming" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Text="{Binding OpenRgbDimProfile, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             Margin="0,3" AutomationProperties.Name="OpenRGB profile while dimming" />
                                    <TextBlock Grid.Row="1" Text="Afterwards" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenRgbRestoreProfile, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             Margin="0,3" AutomationProperties.Name="OpenRGB profile afterwards" />
                                    <TextBlock Grid.Row="2" Text="SDK server port" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OpenRgbPort}" Width="90" HorizontalAlignment="Left"
                                             Margin="0,3" AutomationProperties.Name="OpenRGB port" />
                                </Grid>
                                <TextBlock x:Name="OpenRgbStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Automations -->
        <TabItem x:Name="AutomationsTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Automations">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="M13,2 L4,14 H11 L10,22 L19,10 H12 Z" />
                    <TextBlock Text="Automations" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="WHILE YOU PLAY · UNDONE AFTERWARDS" />
                        <TextBlock Text="Automations" Style="{StaticResource PageTitle}" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PauseWallpaperEngine}">
                                <StackPanel>
                                    <TextBlock Text="Pause Wallpaper Engine" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WallpaperStatus" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideRainmeter}">
                                <StackPanel>
                                    <TextBlock Text="Hide Rainmeter skins" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RainmeterStatus" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoostPriority}">
                                <StackPanel>
                                    <TextBlock Text="Raise the game's priority" FontWeight="SemiBold" />
                                    <TextBlock Text="Normal to Above normal. Games running as administrator or with some anti-cheat don't allow it."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HighPerformancePower}">
                                <StackPanel>
                                    <TextBlock Text="High performance power plan" FontWeight="SemiBold" />
                                    <TextBlock Text="Your current plan comes back afterwards." FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseOneDrive}">
                                <StackPanel>
                                    <TextBlock Text="Close OneDrive" FontWeight="SemiBold" />
                                    <TextBlock Text="Stops syncing from using disk and network; it starts again afterwards." FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Close apps while playing" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                           Text="Launchers, updaters or a browser. Each is asked to close and ended after 3 seconds, so save your work first. The game's own launcher is never closed." />
                                <ui:AppListEditor x:Name="CloseAppsEditor" PickerTitle="Apps to close while playing" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ReopenClosedApps}" Margin="0,6,0,0"
                                          Content="Open them again when I stop playing" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Your own commands" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                           Text="One command per line, run through cmd.exe. Lines starting with # are ignored." />
                                <TextBlock Text="When dimming starts" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Text="{Binding OnDimCommands, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="84"
                                         VerticalContentAlignment="Top" FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Commands when dimming starts" />
                                <TextBlock Text="When dimming ends" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <TextBox Text="{Binding OnRestoreCommands, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="84"
                                         VerticalContentAlignment="Top" FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Commands when dimming ends" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Stats -->
        <TabItem x:Name="StatsTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Stats">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}" Data="M4,20 V10 M10,20 V4 M16,20 V13 M22,20 H2" />
                    <TextBlock Text="Stats" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel>
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="PLAY TIME" />
                        <TextBlock Text="Stats" Style="{StaticResource PageTitle}" />
                    </StackPanel>
                    <ui:StatsView x:Name="Stats" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Settings -->
        <TabItem x:Name="SettingsTab" Style="{StaticResource NavItem}" AutomationProperties.Name="Settings">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource NavIcon}"
                          Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M12,2 V5 M12,19 V22 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M2,12 H5 M19,12 H22 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <ScrollViewer Style="{StaticResource PageScroll}">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <StackPanel Style="{StaticResource PageHeader}">
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="CHANGES ARE SAVED AUTOMATICALLY" />
                        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                    </StackPanel>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="When to dim" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Monitors showing the game stay bright; every other monitor is dimmed." />
                            <ComboBox x:Name="ModeBox" SelectedValuePath="Mode" SelectedValue="{Binding Mode}" AutomationProperties.Name="When to dim" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dimming" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Monitor brightness turns down the screen's own backlight. Monitors that don't support it get the overlay instead; the Monitors page shows which do." />
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="0,0,0,16">
                                <UniformGrid Rows="1" AutomationProperties.Name="How to dim">
                                    <RadioButton Style="{StaticResource Segment}" Content="Black overlay" GroupName="DimMethod"
                                                 IsChecked="{Binding DimMethod, Converter={StaticResource EnumMatch}, ConverterParameter=Overlay}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Monitor brightness" GroupName="DimMethod"
                                                 IsChecked="{Binding DimMethod, Converter={StaticResource EnumMatch}, ConverterParameter=Brightness}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Both" GroupName="DimMethod"
                                                 IsChecked="{Binding DimMethod, Converter={StaticResource EnumMatch}, ConverterParameter=Both}" />
                                </UniformGrid>
                            </Border>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Strength, StringFormat={}{0} %}" FontWeight="Bold" />
                                <TextBlock Text="Darkness" />
                            </DockPanel>
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}" AutomationProperties.Name="Darkness" />
                            <DockPanel Margin="0,12,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding FadeMs, StringFormat={}{0} ms}" FontWeight="Bold" />
                                <TextBlock Text="Fade time" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1500" TickFrequency="50" Value="{Binding FadeMs}" AutomationProperties.Name="Fade time" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideFromCapture}" Margin="0,10,0,0"
                                      Content="Hide the dimming from screenshots, OBS and screen sharing" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LockMouse}">
                                <StackPanel>
                                    <TextBlock Text="Keep the mouse on the game's monitor" FontWeight="SemiBold" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                                               Text="Stops a stray click from minimizing borderless games. Only while the game is in focus; Alt+Tab frees it." />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnDim}"
                                      Content="When a game starts the dimming" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnSessionEnd}"
                                      Content="How long you played, after sessions of 5 minutes or more" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NotifyOnUpdate}"
                                      Content="When a new version is ready" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Keyboard shortcut" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Dims every monitor except the one you are using. Press it again to undo." />
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding HotkeyEnabled}"
                                          AutomationProperties.Name="Keyboard shortcut enabled" Margin="0,0,16,0" />
                                <TextBox x:Name="HotkeyBox" IsReadOnly="True" Width="240" HorizontalAlignment="Left"
                                         IsEnabled="{Binding HotkeyEnabled}" Cursor="Hand" AutomationProperties.Name="Shortcut"
                                         ToolTip="Click, then press the new shortcut"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                            </DockPanel>
                            <TextBlock x:Name="HotkeyProblemText" Foreground="{DynamicResource Danger}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance and startup" Style="{StaticResource SectionTitle}" />
                            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="0,6,0,8" Width="420" HorizontalAlignment="Left">
                                <UniformGrid Rows="1" AutomationProperties.Name="Theme">
                                    <RadioButton Style="{StaticResource Segment}" Content="Dark" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Light" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Same as Windows" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                                </UniformGrid>
                            </Border>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}"
                                      Content="Start with Windows, quietly in the tray" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About and updates" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}"
                                      Content="Download new versions automatically (installed when the app restarts)" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click" />
                                <Button x:Name="InstallUpdateButton" Content="Restart and update" Style="{StaticResource AccentButton}"
                                        Click="InstallUpdate_Click" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            <TextBlock Text="Settings backup" FontWeight="SemiBold" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                       Text="All settings, profiles and lists in one file. Play stats are not included." />
                            <WrapPanel>
                                <Button Content="Export settings…" Click="ExportSettings_Click" Margin="0,0,8,8" />
                                <Button Content="Import settings…" Click="ImportSettings_Click" Margin="0,0,8,8" />
                                <Button Content="Show welcome screen" Click="ShowWelcome_Click" Margin="0,0,8,8" />
                                <Button Content="Open log folder" Click="OpenLog_Click" Margin="0,0,8,8" />
                                <Button Content="Exit Monitor Dimmer" Style="{StaticResource GhostButton}" Click="Exit_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </DockPanel>
    </Border>
</Window>
