<Window x:Class="MonitorDimmer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MonitorDimmer.UI"
        Title="Monitor Dimmer" Width="700" Height="740" MinWidth="580" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource TextMain}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,12,0" DockPanel.Dock="Left" />
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                          Content="Automatic dimming" FontWeight="SemiBold" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Monitor Dimmer" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Changes are saved automatically." Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Hide to tray" Click="Hide_Click" DockPanel.Dock="Right" Margin="0" />
                <Button Content="Exit app" Click="Exit_Click" DockPanel.Dock="Right" />
                <Button Content="Open log folder" Click="OpenLog_Click" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <TabControl Margin="16,10,16,8">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="When to dim" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Monitors showing the app stay bright; every other monitor is dimmed. Apps and game detection are on the Apps tab." />
                                <ComboBox x:Name="ModeBox" SelectedValuePath="Mode" SelectedValue="{Binding Mode}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Dimming" Style="{StaticResource CardTitle}" />
                                <DockPanel Margin="0,6,0,2">
                                    <TextBlock Text="How to dim" Style="{StaticResource FieldLabel}" Width="98" />
                                    <ComboBox x:Name="MethodBox" SelectedValuePath="Value" SelectedValue="{Binding DimMethod}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="110,2,0,0"
                                           Text="Monitor brightness turns down the screen's own backlight. Monitors that don't support it use the overlay; the Monitors tab shows which do." />
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Darkness" Style="{StaticResource FieldLabel}" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5"
                                            Value="{Binding Strength}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Strength, StringFormat={}{0} %}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />

                                    <TextBlock Grid.Row="1" Text="Fade time" Style="{StaticResource FieldLabel}" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1500" TickFrequency="50"
                                            Value="{Binding FadeMs}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FadeMs, StringFormat={}{0} ms}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                                <CheckBox Margin="0,10,0,0" IsChecked="{Binding HideFromCapture}"
                                          Content="Hide the dimming from screenshots, OBS and screen sharing" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="While playing" Style="{StaticResource CardTitle}" />
                                <CheckBox IsChecked="{Binding LockMouse}" Content="Keep the mouse on the game's monitor" />
                                <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,0"
                                           Text="Stops the cursor from slipping onto another monitor and minimizing borderless games. Only while the fullscreen game is in focus: Alt+Tab or the Windows key frees it. Games that lock the cursor themselves keep their own lock." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Keyboard shortcut" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Dims every monitor except the one you are using, without waiting for a fullscreen app. Press it again to undo." />
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding HotkeyEnabled}" Content="Enabled"
                                              DockPanel.Dock="Left" Margin="0,0,16,0" />
                                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Width="220" HorizontalAlignment="Left"
                                             IsEnabled="{Binding HotkeyEnabled}" Cursor="Hand"
                                             ToolTip="Click, then press the new shortcut"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                             LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                </DockPanel>
                                <TextBlock x:Name="HotkeyProblemText" Foreground="{DynamicResource Danger}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Appearance and startup" Style="{StaticResource CardTitle}" />
                                <DockPanel Margin="0,4,0,8">
                                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Width="98" />
                                    <ComboBox x:Name="ThemeBox" SelectedValuePath="Theme" SelectedValue="{Binding Theme}"
                                              Width="220" HorizontalAlignment="Left" />
                                </DockPanel>
                                <CheckBox IsChecked="{Binding StartWithWindows}"
                                          Content="Start with Windows (in the tray, without opening this window)" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="About and updates" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8" />
                                <CheckBox IsChecked="{Binding AutoUpdate}"
                                          Content="Download new versions automatically (installed when the app restarts)" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click" />
                                    <Button x:Name="InstallUpdateButton" Content="Restart and update" Style="{StaticResource AccentButton}"
                                            Click="InstallUpdate_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Apps -->
            <TabItem Header="Apps">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="Scan again" Click="Rescan_Click" DockPanel.Dock="Right" Margin="0" />
                                    <TextBlock Text="Automatic game detection" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Games from Steam, Epic, GOG, Ubisoft, EA, Xbox and Riot, plus anything Windows Game Bar recognises, count as watched apps without adding them below." />
                                <CheckBox IsChecked="{Binding AutoDetectGames}" Content="Detect games automatically" />
                                <TextBlock x:Name="GamesSummary" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,6" />
                                <ListBox x:Name="GamesList" Height="150"
                                         Visibility="{Binding AutoDetectGames, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Source}" DockPanel.Dock="Right"
                                                           Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Watched apps" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Video players and anything else that should start the dimming. Not used in &quot;Any app is fullscreen&quot; mode." />
                                <ui:AppListEditor x:Name="WatchedEditor" PickerTitle="Add watched apps" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Exceptions" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Apps like Discord or OBS: they never start the dimming, and their windows stay fully visible on dimmed monitors." />
                                <ui:AppListEditor x:Name="ExceptionEditor" PickerTitle="Add exceptions" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Profiles -->
            <TabItem Header="Profiles">
                <ui:ProfilesView x:Name="Profiles" />
            </TabItem>

            <!-- Monitors -->
            <TabItem Header="Monitors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="Identify monitors" Click="Identify_Click" DockPanel.Dock="Right" Margin="0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Text="Settings for each connected monitor. By default every monitor uses the darkness from the General tab." />
                        </DockPanel>
                        <ItemsControl x:Name="MonitorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{Binding BrightnessStatus}" Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                            <CheckBox IsChecked="{Binding NeverDim}" Content="Never dim this monitor" />
                                            <CheckBox IsChecked="{Binding UseCustomStrength}" Content="Use its own darkness" />
                                            <Grid Margin="26,4,0,0"
                                                  Visibility="{Binding UseCustomStrength, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Strength, StringFormat={}{0} %}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Lighting -->
            <TabItem Header="Lighting">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="RGB lighting while dimming" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Keyboards, mice, headsets and other RGB devices go dark or switch to a dim color with your monitors, then go back to your normal lighting." />
                                <CheckBox IsChecked="{Binding RgbEnabled}" Content="Change RGB lighting while dimming" />
                                <StackPanel Margin="26,6,0,0" IsEnabled="{Binding RgbEnabled}">
                                    <RadioButton x:Name="RgbOffRadio" GroupName="RgbStyle" Content="Turn the lights off"
                                                 Checked="RgbStyle_Checked" />
                                    <RadioButton x:Name="RgbColorRadio" GroupName="RgbStyle" Content="Use a dim color"
                                                 Checked="RgbStyle_Checked" />
                                    <StackPanel x:Name="ColorPanel" Margin="26,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="ColorPreview" Width="32" Height="32" CornerRadius="6"
                                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Margin="0,0,10,0" />
                                            <TextBox Text="{Binding RgbColor, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                     Width="96" FontFamily="Consolas" Margin="0,0,14,0" ToolTip="Color as #RRGGBB" />
                                            <ItemsControl x:Name="Swatches" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                                                Tag="{Binding Hex}" ToolTip="{Binding Hex}" Click="Swatch_Click" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                                            <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5"
                                                    Value="{Binding RgbBrightness}" />
                                            <TextBlock Grid.Column="2" Text="{Binding RgbBrightness, StringFormat={}{0} %}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <Button Content="Preview for 3 seconds" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="PreviewLighting_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Devices" Style="{StaticResource CardTitle}" />
                                <CheckBox IsChecked="{Binding UseRazerChroma}" Content="Razer Chroma (Razer Synapse)" />
                                <TextBlock x:Name="RazerStatus" Style="{StaticResource Hint}" Margin="26,0,0,10" />

                                <CheckBox IsChecked="{Binding UseOpenRgb}" Content="OpenRGB (ASUS Aura, Corsair, Logitech, MSI and more)" />
                                <StackPanel Margin="26,0,0,0">
                                    <TextBlock Style="{StaticResource Hint}">
                                        In OpenRGB, save one profile for dimming and one with your normal lighting, then turn on
                                        SDK Server → Start Server. Close Armoury Crate's lighting if it fights with OpenRGB over ASUS devices.
                                    </TextBlock>
                                    <Grid IsEnabled="{Binding UseOpenRgb}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Profile while dimming" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Column="1" Text="{Binding OpenRgbDimProfile, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 Margin="0,2" />
                                        <TextBlock Grid.Row="1" Text="Profile afterwards" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding OpenRgbRestoreProfile, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Text="SDK server port" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OpenRgbPort}" Width="80"
                                                 HorizontalAlignment="Left" Margin="0,2" />
                                    </Grid>
                                    <TextBlock x:Name="OpenRgbStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Actions -->
            <TabItem Header="Actions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Built-in actions" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Run when dimming starts and undone when it ends. Each one only acts on apps that are running." />
                                <CheckBox IsChecked="{Binding PauseWallpaperEngine}" Content="Pause Wallpaper Engine" />
                                <TextBlock x:Name="WallpaperStatus" Style="{StaticResource Hint}" Margin="26,0,0,8" />
                                <CheckBox IsChecked="{Binding HideRainmeter}" Content="Hide Rainmeter skins" />
                                <TextBlock x:Name="RainmeterStatus" Style="{StaticResource Hint}" Margin="26,0,0,8" />
                                <CheckBox IsChecked="{Binding HighPerformancePower}" Content="Switch to the High performance power plan" />
                                <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,8"
                                           Text="Your current power plan comes back afterwards." />
                                <CheckBox IsChecked="{Binding CloseOneDrive}" Content="Close OneDrive" />
                                <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,0"
                                           Text="Stops syncing from using disk and network during games; it starts again afterwards." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Your own commands" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}">
                                    For anything else. One command per line, run through cmd.exe. Lines starting with # are ignored.
                                </TextBlock>
                                <TextBlock Text="When dimming starts" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding OnDimCommands, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="84"
                                         VerticalContentAlignment="Top" FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="When dimming ends" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding OnRestoreCommands, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" Height="84"
                                         VerticalContentAlignment="Top" FontFamily="Consolas"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Stats -->
            <TabItem Header="Stats">
                <ui:StatsView x:Name="Stats" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
