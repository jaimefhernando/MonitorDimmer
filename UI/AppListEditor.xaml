<UserControl x:Class="MonitorDimmer.UI.AppListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <ListBox x:Name="List" Height="132" SelectionMode="Extended" KeyDown="List_KeyDown"
                     AutomationProperties.Name="Apps" />
            <TextBlock x:Name="EmptyText" Text="No apps yet." Style="{StaticResource Hint}"
                       Margin="12,9,0,0" VerticalAlignment="Top" IsHitTestVisible="False" />
        </Grid>
        <!-- Type a name and add it -->
        <DockPanel Margin="0,8,0,0">
            <Button Content="Add" Click="Add_Click" DockPanel.Dock="Right" MinWidth="64" Margin="8,0,0,0" />
            <TextBox x:Name="NameBox" ToolTip="Program name, for example vlc.exe" KeyDown="NameBox_KeyDown"
                     AutomationProperties.Name="Program name to add" />
        </DockPanel>
        <!-- Or pick one; remove the selected ones -->
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button Content="Add running app…" Click="Pick_Click" DockPanel.Dock="Left" />
            <Button Content="Remove selected" Click="Remove_Click" DockPanel.Dock="Right" Margin="0"
                    Style="{StaticResource GhostButton}" />
        </DockPanel>
    </StackPanel>
</UserControl>
