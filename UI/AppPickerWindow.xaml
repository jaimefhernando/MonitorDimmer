<Window x:Class="MonitorDimmer.UI.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextMain}"
        FontFamily="{DynamicResource AppFont}" FontSize="14">
    <DockPanel Margin="16">
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                   Text="Apps with an open window right now. Select one or more (Ctrl+click) and choose Add." />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                 TextChanged="SearchBox_TextChanged" ToolTip="Filter by name or window title" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Click="Refresh_Click" />
            <Button Content="Add" IsDefault="True" Click="Add_Click" Style="{StaticResource AccentButton}" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
        <ListBox x:Name="AppList" SelectionMode="Extended" MouseDoubleClick="AppList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource TextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
