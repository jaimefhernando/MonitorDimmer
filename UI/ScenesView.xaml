<UserControl x:Class="Shadeplay.UI.ScenesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shadeplay.UI.Controls">
    <UserControl.Resources>
        <Style x:Key="SceneItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1" Padding="16,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <ListBox x:Name="SceneList" ItemContainerStyle="{StaticResource SceneItem}" Background="Transparent" BorderThickness="0"
                     Padding="0" AutomationProperties.Name="Scenes" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="SceneList_SelectionChanged" PreviewMouseWheel="SceneList_PreviewMouseWheel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" Padding="6,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="IN USE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentText}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMain}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="+  New scene" Click="Add_Click" HorizontalAlignment="Left" MinHeight="40" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Top"
                   Text="Pick a scene to change what it does." />

        <c:ChamferBorder x:Name="Editor" Grid.Column="2" MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Top" Chamfer="16"
                         Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                         DataContext="{Binding SelectedItem, ElementName=SceneList}">
            <StackPanel>
                <DockPanel Margin="22,20,22,18">
                    <Button x:Name="UseButton" DockPanel.Dock="Right" Click="Use_Click" MinHeight="44" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Content" Value="Use now" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Content" Value="Back to Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontSize="20" FontWeight="Bold"
                             Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" VerticalAlignment="Center"
                             AutomationProperties.Name="Scene name" ToolTip="Click to rename" />
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Divider}" />

                <StackPanel Margin="22,18,22,22">
                    <TextBlock Style="{StaticResource Hint}" FontSize="12"
                               Text="Default means the scene leaves that setting as it is. A game's own profile still wins where it sets something." />

                    <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="DIMMING" Margin="0,4,0,4" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CustomStrength}" Content="Own darkness" />
                    <DockPanel IsEnabled="{Binding CustomStrength}" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Strength, StringFormat={}{0} %}" FontWeight="Bold"
                                   Width="48" TextAlignment="Right" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                        <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}" AutomationProperties.Name="Darkness" />
                    </DockPanel>
                    <Border Style="{StaticResource SegmentBox}" Margin="0,0,0,18">
                        <UniformGrid Rows="1" AutomationProperties.Name="How to dim">
                            <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="SceneMethod"
                                         IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Overlay" GroupName="SceneMethod"
                                         IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Overlay}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Brightness" GroupName="SceneMethod"
                                         IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Brightness}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Both" GroupName="SceneMethod"
                                         IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Both}" />
                        </UniformGrid>
                    </Border>

                    <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="LIGHTING" Margin="0,0,0,8" />
                    <Border Style="{StaticResource SegmentBox}">
                        <UniformGrid Rows="1" AutomationProperties.Name="Lighting">
                            <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="SceneLighting"
                                         IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Leave" GroupName="SceneLighting" ToolTip="Leave my lighting alone"
                                         IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Unchanged}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="SceneLighting"
                                         IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Color" GroupName="SceneLighting"
                                         IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Color}" />
                        </UniformGrid>
                    </Border>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Lighting}" Value="Color">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel>
                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Width="84" />
                            <TextBox Text="{Binding RgbColor, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     Width="100" FontFamily="Consolas" HorizontalAlignment="Left" ToolTip="#RRGGBB"
                                     AutomationProperties.Name="Lighting color" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RgbBrightness, StringFormat={}{0} %}" FontWeight="Bold"
                                       Width="48" TextAlignment="Right" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                            <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Width="84" />
                            <Slider Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding RgbBrightness}"
                                    AutomationProperties.Name="Lighting brightness" />
                        </DockPanel>
                    </StackPanel>

                    <UniformGrid Columns="1" Margin="0,18,0,0" Width="420" HorizontalAlignment="Left">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="MOUSE LOCK" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SegmentBox}">
                                <UniformGrid Rows="1" AutomationProperties.Name="Mouse lock">
                                    <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="SceneMouse"
                                                 IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="On" GroupName="SceneMouse"
                                                 IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=On}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="SceneMouse"
                                                 IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="NIGHT TINT" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SegmentBox}">
                                <UniformGrid Rows="1" AutomationProperties.Name="Night tint">
                                    <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="SceneNight"
                                                 IsChecked="{Binding Night, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="On" GroupName="SceneNight"
                                                 IsChecked="{Binding Night, Converter={StaticResource EnumMatch}, ConverterParameter=On}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="SceneNight"
                                                 IsChecked="{Binding Night, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="SIDE DISPLAY" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SegmentBox}">
                                <UniformGrid Rows="1" AutomationProperties.Name="Quiet side display">
                                    <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="SceneSide"
                                                 IsChecked="{Binding SideDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="On" GroupName="SceneSide"
                                                 IsChecked="{Binding SideDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=On}" />
                                    <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="SceneSide"
                                                 IsChecked="{Binding SideDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="Remove scene" Style="{StaticResource LinkButton}" Click="Remove_Click" HorizontalAlignment="Left"
                            Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
