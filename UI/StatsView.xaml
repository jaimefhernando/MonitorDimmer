<UserControl x:Class="MonitorDimmer.UI.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,12" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Button Content="Clear history" Click="Clear_Click" DockPanel.Dock="Right" Margin="0" />
                <ComboBox x:Name="RangeBox" Width="140" SelectionChanged="Filter_Changed" Margin="0,0,14,0" />
                <CheckBox x:Name="GamesOnlyCheck" Content="Games only" IsChecked="True"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,0,14,0" />
                <CheckBox IsChecked="{Binding TrackSessions}" Content="Record play time" />
            </DockPanel>

            <!-- Summary -->
            <UniformGrid Columns="4" Margin="0,0,-10,0">
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock x:Name="TotalText" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Total play time" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock x:Name="CountText" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Sessions" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock x:Name="LongestText" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Longest session" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock x:Name="TopText" Style="{StaticResource TileValue}" />
                        <TextBlock Text="Most played" Style="{StaticResource TileLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" Margin="2,4,0,12" />

            <!-- Per game -->
            <Border x:Name="ByGameCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="By game" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="ByGameList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                               ToolTip="{Binding ExeName}" />
                                    <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Bar}" />
                                            <ColumnDefinition Width="{Binding Rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" CornerRadius="5" Background="{DynamicResource ControlBg}" />
                                        <Border CornerRadius="5" Background="{DynamicResource Accent}" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Per day -->
            <Border x:Name="ByDayCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Last 14 days" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="ByDayList" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0" ToolTip="{Binding Tip}">
                                    <Grid Height="90">
                                        <Border VerticalAlignment="Bottom" Height="{Binding Height}" CornerRadius="3,3,0,0"
                                                Background="{DynamicResource Accent}" MinHeight="2" />
                                    </Grid>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent -->
            <Border x:Name="RecentCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent sessions" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="RecentList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding When}" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
