<UserControl x:Class="Shadeplay.UI.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shadeplay.UI.Controls">
    <UserControl.Resources>
        <!-- One game tile in the library -->
        <Style x:Key="Tile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="172" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- Library of profiles -->
        <Grid>
            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" ItemContainerStyle="{StaticResource Tile}"
                     Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Games with a profile"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid Height="104" Background="{DynamicResource DimmedStripes}">
                                <TextBlock Text="{Binding Name, Converter={x:Static c:MonogramConverter.Instance}}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="12,10,12,12">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{Binding ExeName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="EmptyListText" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="No game profiles yet" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0"
                               Text="Every detected game is dimmed with your normal settings. Add a game to give it its own darkness, monitors, lighting and actions." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Editor for the selected profile -->
        <c:ChamferBorder x:Name="Editor" Grid.Column="2" VerticalAlignment="Top" Chamfer="16"
                         Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                         DataContext="{Binding SelectedItem, ElementName=ProfileList}">
            <StackPanel>
                <DockPanel Margin="22,20,22,18">
                    <Border DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,14,0" Background="{DynamicResource SelectedBg}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                        <TextBlock Text="{Binding Name, Converter={x:Static c:MonogramConverter.Instance}}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontSize="20" FontWeight="Bold"
                                 Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
                                 AutomationProperties.Name="Profile name" ToolTip="Click to rename" />
                        <TextBlock Text="{Binding ExeName}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Divider}" />

                <StackPanel Margin="22,18,22,22">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NeverDim}">
                        <StackPanel>
                            <TextBlock Text="Never dim for this game" FontWeight="SemiBold" />
                            <TextBlock Text="It won't start the dimming at all" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeverDim}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Dimming -->
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="DIMMING" Margin="0,0,0,4" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CustomStrength}" Content="Own darkness" />
                        <DockPanel IsEnabled="{Binding CustomStrength}" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Strength, StringFormat={}{0} %}" FontWeight="Bold"
                                       Width="48" TextAlignment="Right" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}" AutomationProperties.Name="Darkness" />
                        </DockPanel>
                        <Border Style="{StaticResource SegmentBox}" Margin="0,0,0,18">
                            <UniformGrid Rows="1" AutomationProperties.Name="How to dim">
                                <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="Method"
                                             IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Overlay" GroupName="Method"
                                             IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Overlay}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Brightness" GroupName="Method"
                                             IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Brightness}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Both" GroupName="Method"
                                             IsChecked="{Binding Method, Converter={StaticResource EnumMatch}, ConverterParameter=Both}" />
                            </UniformGrid>
                        </Border>

                        <!-- Keep bright -->
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="ALSO KEEP BRIGHT" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,2" FontSize="12"
                                   Text="For example the monitor with Discord or a guide." />
                        <ItemsControl x:Name="KeepBrightList" Margin="0,0,0,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Lighting -->
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="LIGHTING" Margin="0,0,0,8" />
                        <Border Style="{StaticResource SegmentBox}">
                            <UniformGrid Rows="1" AutomationProperties.Name="Lighting">
                                <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="Lighting"
                                             IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Leave" GroupName="Lighting" ToolTip="Leave my lighting alone"
                                             IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Unchanged}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="Lighting"
                                             IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Color" GroupName="Lighting"
                                             IsChecked="{Binding Lighting, Converter={StaticResource EnumMatch}, ConverterParameter=Color}" />
                            </UniformGrid>
                        </Border>
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Lighting}" Value="Color">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <DockPanel>
                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Width="84" />
                                <TextBox Text="{Binding RgbColor, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         Width="100" FontFamily="Consolas" HorizontalAlignment="Left" ToolTip="#RRGGBB"
                                         AutomationProperties.Name="Lighting color" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RgbBrightness, StringFormat={}{0} %}" FontWeight="Bold"
                                           Width="48" TextAlignment="Right" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                                <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" Width="84" />
                                <Slider Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding RgbBrightness}"
                                        AutomationProperties.Name="Lighting brightness" />
                            </DockPanel>
                        </StackPanel>

                        <!-- Mouse -->
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="MOUSE LOCK" Margin="0,18,0,8" />
                        <Border Style="{StaticResource SegmentBox}">
                            <UniformGrid Rows="1" AutomationProperties.Name="Mouse lock">
                                <RadioButton Style="{StaticResource Segment}" Content="Default" GroupName="Mouse"
                                             IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=Default}" />
                                <RadioButton Style="{StaticResource Segment}" Content="On" GroupName="Mouse"
                                             IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=On}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Off" GroupName="Mouse"
                                             IsChecked="{Binding MouseLock, Converter={StaticResource EnumMatch}, ConverterParameter=Off}" />
                            </UniformGrid>
                        </Border>

                        <!-- Actions -->
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="WHILE PLAYING" Margin="0,18,0,0" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CustomActions}" Content="Own automations for this game" />
                        <StackPanel IsEnabled="{Binding CustomActions}">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PauseWallpaperEngine}" Content="Pause Wallpaper Engine" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideRainmeter}" Content="Hide Rainmeter skins" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoostPriority}" Content="Raise the game's priority" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HighPerformancePower}" Content="High performance power plan" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseOneDrive}" Content="Close OneDrive" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseApps}" Content="Close the apps on the Automations page" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Remove profile" Style="{StaticResource LinkButton}" Click="Remove_Click" HorizontalAlignment="Left"
                            Margin="0,14,0,0" />
                </StackPanel>
            </StackPanel>
        </c:ChamferBorder>
    </Grid>
</UserControl>
