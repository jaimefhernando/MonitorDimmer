<UserControl x:Class="MonitorDimmer.UI.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Profile list -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                       Text="Settings for one game. Anything not changed here follows the other tabs." />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add game…" Click="Add_Click" Style="{StaticResource AccentButton}" />
                <Button Content="Remove" Click="Remove_Click" Margin="0" />
            </StackPanel>
            <Grid>
                <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ExeName}" Foreground="{DynamicResource TextMuted}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyListText" Style="{StaticResource Hint}" Margin="12,10,12,0"
                           VerticalAlignment="Top" IsHitTestVisible="False"
                           Text="No profiles yet. Add a game you play to give it its own settings." />
            </Grid>
        </DockPanel>

        <!-- Editor for the selected profile -->
        <TextBlock x:Name="NoSelectionText" Grid.Column="2" Style="{StaticResource Hint}" Margin="4,30,0,0"
                   Text="Select a profile on the left, or add one." />
        <ScrollViewer x:Name="Editor" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                      DataContext="{Binding SelectedItem, ElementName=ProfileList}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Game" Style="{StaticResource CardTitle}" />
                        <DockPanel Margin="0,4,0,8">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Width="56" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8">
                            <Run Text="Program:" /> <Run Text="{Binding ExeName, Mode=OneWay}" />
                        </TextBlock>
                        <CheckBox IsChecked="{Binding NeverDim}" Content="Never dim for this app" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NeverDim}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Dimming" Style="{StaticResource CardTitle}" />
                            <CheckBox IsChecked="{Binding CustomStrength}" Content="Own darkness" />
                            <Grid Margin="26,4,0,6" IsEnabled="{Binding CustomStrength}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="10" Maximum="100" TickFrequency="5" Value="{Binding Strength}" />
                                <TextBlock Grid.Column="1" Text="{Binding Strength, StringFormat={}{0} %}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <DockPanel Margin="0,4,0,10">
                                <TextBlock Text="How to dim" Style="{StaticResource FieldLabel}" Width="84" />
                                <ComboBox x:Name="MethodBox" SelectedValuePath="Value" SelectedValue="{Binding Method}" />
                            </DockPanel>
                            <TextBlock Text="Also keep these monitors bright" FontWeight="SemiBold" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="For example the monitor where you keep Discord or a guide open." />
                            <ItemsControl x:Name="KeepBrightList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Lighting" Style="{StaticResource CardTitle}" />
                            <ComboBox x:Name="LightingBox" SelectedValuePath="Value" SelectedValue="{Binding Lighting}" />
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lighting}" Value="Color">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel>
                                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}" Width="84" />
                                    <TextBox Text="{Binding RgbColor, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                             Width="96" FontFamily="Consolas" HorizontalAlignment="Left" ToolTip="#RRGGBB" />
                                </DockPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}" />
                                    <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" Value="{Binding RgbBrightness}" />
                                    <TextBlock Grid.Column="2" Text="{Binding RgbBrightness, StringFormat={}{0} %}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Mouse" Style="{StaticResource CardTitle}" />
                            <DockPanel>
                                <TextBlock Text="Mouse lock" Style="{StaticResource FieldLabel}" Width="84" />
                                <ComboBox x:Name="MouseLockBox" SelectedValuePath="Value" SelectedValue="{Binding MouseLock}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Actions" Style="{StaticResource CardTitle}" />
                            <CheckBox IsChecked="{Binding CustomActions}" Content="Own built-in actions for this game" />
                            <StackPanel Margin="26,4,0,0" IsEnabled="{Binding CustomActions}">
                                <CheckBox IsChecked="{Binding PauseWallpaperEngine}" Content="Pause Wallpaper Engine" />
                                <CheckBox IsChecked="{Binding HideRainmeter}" Content="Hide Rainmeter skins" />
                                <CheckBox IsChecked="{Binding HighPerformancePower}" Content="High performance power plan" />
                                <CheckBox IsChecked="{Binding CloseOneDrive}" Content="Close OneDrive" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
