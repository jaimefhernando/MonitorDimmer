<Window x:Class="MonitorDimmer.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Monitor Dimmer" Width="640" Height="720" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextMain}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,20">
            <DockPanel>
                <Image x:Name="HeaderIcon" Width="40" Height="40" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Welcome to Monitor Dimmer" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="When a game or video goes fullscreen, your other monitors go dark so they don't pull your eyes away. Here's what I found on this PC. Keep the suggestions you like; you can change everything later in Settings." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="The app keeps running in the tray, by the clock." Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Content="Apply and finish" Style="{StaticResource AccentButton}" Click="Apply_Click"
                        DockPanel.Dock="Right" Margin="0" IsDefault="True" />
                <Button Content="Skip" Click="Skip_Click" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,16,8">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Your monitors" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="MonitorList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Suggested settings" Style="{StaticResource CardTitle}" />
                        <ItemsControl x:Name="SuggestionList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12" IsEnabled="{Binding IsAvailable}">
                                        <CheckBox IsChecked="{Binding IsChecked}" FontWeight="SemiBold">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="26,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
