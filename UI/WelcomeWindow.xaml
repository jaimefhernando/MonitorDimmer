<Window x:Class="MonitorDimmer.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MonitorDimmer.UI.Controls"
        Title="Welcome to Monitor Dimmer" Width="780" Height="820" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextMain}"
        FontFamily="{DynamicResource AppFont}" FontSize="14">
    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="32,14">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Monitor Dimmer keeps running in the tray, by the clock." Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="Wrap" />
                <Button Content="Apply and finish" Style="{StaticResource AccentButton}" Click="Apply_Click"
                        DockPanel.Dock="Right" Margin="0" MinHeight="44" IsDefault="True" />
                <Button Content="Skip" Click="Skip_Click" DockPanel.Dock="Right" MinHeight="44" Style="{StaticResource GhostButton}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,24,20">
            <StackPanel>
                <!-- Logo and welcome -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                    <Grid Width="34" Height="28" Margin="0,0,12,0">
                        <Border Width="20" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#3A3F48" CornerRadius="3" />
                        <Border Width="22" Height="17" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                Background="{DynamicResource Accent}" BorderBrush="{DynamicResource WindowBg}"
                                BorderThickness="2" CornerRadius="3" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock c:Tracking.Text="MONITOR" FontWeight="Bold" FontSize="15" />
                        <TextBlock c:Tracking.Text="DIMMER" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Rectangle Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Rectangle.LayoutTransform>
                            <RotateTransform Angle="45" />
                        </Rectangle.LayoutTransform>
                    </Rectangle>
                    <TextBlock c:Tracking.Text="WELCOME" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                </StackPanel>
                <TextBlock Text="Let's set up your screens" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
                <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,24"
                           Text="When a game or video goes fullscreen, your other monitors go dark so they don't pull your eyes away. Here's what I found on this PC. Keep the suggestions you like; you can change everything later." />

                <!-- Monitors -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="YOUR MONITORS" Margin="0,0,0,14" />
                        <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                Padding="22" Height="190" Margin="0,0,0,12">
                            <c:MonitorMap x:Name="Map" />
                        </Border>
                        <ItemsControl x:Name="MonitorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{Binding BadgeBrush}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Suggestions -->
                <c:ChamferBorder Chamfer="16" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource ControlBorder}"
                                 BorderThickness="1" Padding="22,18,22,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Kicker}" c:Tracking.Text="SUGGESTED SETTINGS" Margin="0,0,0,4" />
                        <ItemsControl x:Name="SuggestionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,6"
                                            IsEnabled="{Binding IsAvailable}">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsChecked}"
                                                  AutomationProperties.Name="{Binding Title}">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
