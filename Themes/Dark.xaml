<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphite with one amber accent -->
    <SolidColorBrush x:Key="WindowBg" Color="#0A0B0D" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0E1013" />
    <SolidColorBrush x:Key="CardBg" Color="#111317" />
    <SolidColorBrush x:Key="CardBorder" Color="#23272E" />
    <SolidColorBrush x:Key="Divider" Color="#1C2026" />
    <SolidColorBrush x:Key="TextMain" Color="#ECEEF1" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3A9B2" />
    <SolidColorBrush x:Key="TextMuted" Color="#8C929C" />
    <SolidColorBrush x:Key="Accent" Color="#F2B33D" />
    <SolidColorBrush x:Key="AccentText" Color="#14110A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#2B2416" />
    <SolidColorBrush x:Key="Danger" Color="#FF7B72" />
    <SolidColorBrush x:Key="Success" Color="#3FB950" />
    <SolidColorBrush x:Key="ControlBg" Color="#15181C" />
    <SolidColorBrush x:Key="ControlHoverBg" Color="#1E2228" />
    <SolidColorBrush x:Key="ControlPressedBg" Color="#262A31" />
    <SolidColorBrush x:Key="ControlBorder" Color="#2A2F37" />
    <SolidColorBrush x:Key="InputBg" Color="#0B0C0F" />
    <SolidColorBrush x:Key="ItemHoverBg" Color="#1A1D22" />
    <SolidColorBrush x:Key="SelectedBg" Color="#1A1D22" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3F48" />
    <SolidColorBrush x:Key="SwitchOff" Color="#22262C" />
    <SolidColorBrush x:Key="KnobOff" Color="#6B717B" />
    <SolidColorBrush x:Key="Inverse" Color="#ECEEF1" />
    <SolidColorBrush x:Key="InverseText" Color="#0A0B0D" />
    <SolidColorBrush x:Key="Monogram" Color="#5D636C" />
    <SolidColorBrush x:Key="CloseHoverBg" Color="#E5484D" />
    <SolidColorBrush x:Key="ClosePressedBg" Color="#C23A3F" />
    <!-- Diagonal stripes that mark a dimmed monitor -->
    <DrawingBrush x:Key="DimmedStripes" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0D0F12" Geometry="M0,0 L12,0 12,12 0,12Z" />
                <GeometryDrawing Brush="#14171B" Geometry="M0,6 L6,0 9,0 0,9Z M6,12 L12,6 12,9 9,12Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
