<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Same structure as Dark.xaml: light greys with the amber accent -->
    <SolidColorBrush x:Key="WindowBg" Color="#F2F3F5" />
    <SolidColorBrush x:Key="SidebarBg" Color="#E8EAED" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#DADDE2" />
    <SolidColorBrush x:Key="Divider" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextMain" Color="#16181C" />
    <SolidColorBrush x:Key="TextSecondary" Color="#454B54" />
    <SolidColorBrush x:Key="TextMuted" Color="#5F6670" />
    <SolidColorBrush x:Key="Accent" Color="#C98A12" />
    <SolidColorBrush x:Key="AccentText" Color="#14110A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FBEFD6" />
    <SolidColorBrush x:Key="Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="Success" Color="#2E8B57" />
    <SolidColorBrush x:Key="ControlBg" Color="#F6F7F9" />
    <SolidColorBrush x:Key="ControlHoverBg" Color="#ECEEF2" />
    <SolidColorBrush x:Key="ControlPressedBg" Color="#E0E3E9" />
    <SolidColorBrush x:Key="ControlBorder" Color="#C8CCD3" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ItemHoverBg" Color="#EEF0F3" />
    <SolidColorBrush x:Key="SelectedBg" Color="#E3E6EA" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C2C6CE" />
    <SolidColorBrush x:Key="SwitchOff" Color="#D5D9DF" />
    <SolidColorBrush x:Key="KnobOff" Color="#7A818B" />
    <SolidColorBrush x:Key="Inverse" Color="#16181C" />
    <SolidColorBrush x:Key="InverseText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Monogram" Color="#8A9099" />
    <DrawingBrush x:Key="DimmedStripes" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#D9DCE1" Geometry="M0,0 L12,0 12,12 0,12Z" />
                <GeometryDrawing Brush="#CDD1D7" Geometry="M0,6 L6,0 9,0 0,9Z M6,12 L12,6 12,9 9,12Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
